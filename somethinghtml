<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>USER HOME</h1>
    <h2>PRODUCTS</h2>
    <button><a href="{% url 'cartitems' %}">ViewCart</a></button><br>
    <button><a href="{% url 'vieworder' %}">ViewOrder</a></button><br>
    <button><a href="{% url 'userdetails' %}">User Details</a></button>
   <br><button><a href="{% url 'logout' %}">logout</a></button>

<div class="container">

{% for i in data %}

<div class="card">

{% if i.image %}
<img src="{{ i.image.url }}" width="150">
{% else %}
<p>No Image</p>
{% endif %}

<h3>{{ i.name }}</h3>
<p>Price: {{ i.price }}</p>
<a href="{% url 'productdetails' i.id %}">Details</a><br>
</div>

{% empty %}

<h2>No Products Available</h2>

{% endfor %}

</div>
    

<br><a href="{% url 'logout' %}">logout</a>


        <!-- image,name,price, -->

</body>
</html>



